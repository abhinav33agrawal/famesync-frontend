# Copy to .env for local development:  cp .env.example .env
#
# Vite inlines these at BUILD time, so every value is public and a change
# does nothing until you rebuild.
#
#   local        http://localhost:8000/api
#   production   https://backend.famesync.com/api  (set in .env.production)
#
# Keep the /api suffix and do not add a trailing slash.
VITE_API_URL=http://localhost:8000/api
