# Copy to .env for local development:  cp .env.example .env
#
# Vite inlines these into the JavaScript bundle at BUILD time, so:
#   - every value here is PUBLIC — anyone can read it in devtools.
#     Never put a secret, an API key or a client *secret* behind a VITE_ name.
#   - changing a value does nothing until you rebuild/redeploy.
#
# On Vercel these are set under Settings -> Environment Variables, not here.
# See DEPLOYMENT.md.


# -------------------------------------------------------------- required

# Base URL of the Django API, including the /api suffix.
#
#   local        http://localhost:8000/api
#   production   https://backend.famesync.com/api
#
# Three rules, each of which breaks the site if ignored:
#   1. Keep the /api suffix. The app derives the media origin by stripping a
#      trailing /api, so .../api yields .../media/... for uploaded pictures.
#   2. No trailing slash — .../api, not .../api/
#   3. Use https in production. The Vercel site is https, so a plain-http API
#      URL is blocked as mixed content and every request fails.
VITE_API_URL=http://localhost:8000/api


# -------------------------------------------------------------- optional

# Google OAuth *web client ID* (Google Cloud console -> Credentials).
# Only powers the "Continue with Google" button — leave it blank and the rest
# of the app works fine, with that button disabled. Email/password and
# Instagram sign-in are unaffected.
#
# Remember to add your site origin (e.g. https://famesync.com) to the
# client's Authorised JavaScript origins, or Google returns origin_mismatch.
VITE_GOOGLE_CLIENT_ID=


# ------------------------------------------------------------ not here

# Instagram OAuth is served by the Django API, not by a separate service, so
# there is no VITE_INSTAGRAM_SERVICE_URL any more. Its credentials are set in
# the BACKEND .env — INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET and
# INSTAGRAM_REDIRECT_URI. A client secret must never reach this file: anything
# here ships to the browser.
