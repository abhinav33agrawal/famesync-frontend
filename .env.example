# The Django API, including the /api prefix.
# Local:      http://localhost:8000/api
# Production: https://api.famesync.com/api
VITE_API_URL=http://localhost:8000/api

# Google OAuth web client id (Google Cloud console -> Credentials).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Instagram OAuth is served by the Django API now, so there is no separate
# service URL. Configure INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET /
# INSTAGRAM_REDIRECT_URI on the backend instead.
