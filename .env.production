# ---------------------------------------------------------------------------
# FameSync frontend - PRODUCTION defaults
# Loaded automatically by `vite build` (mode=production). Committed on purpose:
# every VITE_ value is public and ships to the browser, and this guarantees a
# production build never bakes in the localhost fallback.
#
# Vercel: variables set under Settings -> Environment Variables take priority
# over this file, so keep VITE_API_URL there in sync with this value.
# ---------------------------------------------------------------------------

# Live Django API. Keep the /api suffix, no trailing slash - the app strips a
# trailing /api to derive the media origin (https://backend.famesync.com/media/...).
VITE_API_URL=https://backend.famesync.com/api

# VITE_GOOGLE_CLIENT_ID is intentionally not set here - configure it in the
# Vercel dashboard so it can differ per environment.
